{
  "name": "video-downloader-front-end",
  "version": "1.4.112",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sass-embedded": "^1.107.0",
    "simple-git": "^4.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-router/node": "^8.5.1",
    "@sentry/react": "^11.10.0",
    "axios": "^1.21.0",
    "classnames": "^2.5.1",
    "isbot": "^5.2.2",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "npm run env-vars && react-router build",
    "ci:checks": "npm run typecheck && npm run lint && npm run test:coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "env-vars": "node scripts/env-vars.mjs",
    "lint": "oxlint app tests e2e playwright.config.ts --type-aware",
    "lint:fix": "oxlint app tests e2e playwright.config.ts --type-aware --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "npm run env-vars && VITE_API_URL=https://api.video.home.ruchij.com react-router dev --host 0.0.0.0",
    "start:dev": "react-router dev --host 0.0.0.0",
    "start:local": "npm run env-vars && VITE_API_URL=https://api.localhost react-router dev",
    "start:staging": "npm run env-vars && VITE_API_URL=https://api.staging.video.dev.ruchij.com react-router dev --host 0.0.0.0",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "react-router typegen && tsc"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
