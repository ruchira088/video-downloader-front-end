{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-empty-pattern": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/prefer-as-const": "warn",
    // Static methods carry no `this` binding risk, so passing `Option.fromNullable` or
    // Luxon's `DateTime.fromISO` as a callback is safe.
    "typescript/unbound-method": ["error", { "ignoreStatic": true }],
    "typescript/explicit-module-boundary-types": "off",
    "typescript/ban-types": "off",
    "typescript/no-empty-object-type": "off",
    "react/rules-of-hooks": "error",
    // Currently clean; kept at warn so a new violation does not block a build.
    "react/exhaustive-deps": "warn",
    // React Compiler rules added to the `correctness` category in oxlint 1.79. `set-state-in-effect`
    // cannot see through an `await`, so it flags every effect that kicks off an async load; those
    // six sites carry a local disable with the reason. The remaining rules are clean.
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "react/immutability": "error",
    // React Compiler is not part of this build (no babel-plugin-react-compiler in the Vite config),
    // so "memoization could not be preserved" reports nothing that affects the shipped bundle. It
    // fires on `shuffleArray` in PlaylistDetail, which mutates a local copy before returning it.
    "react/preserve-manual-memoization": "off",
    // React 19 with the automatic JSX runtime ("jsx": "react-jsx"), so React need not be in scope.
    "react/react-in-jsx-scope": "off",
    // The hand-rolled Option/Either types expose `.map`, which returns a single element rather
    // than a list, so every hit in this codebase is a false positive.
    "react/jsx-key": "off"
  },
  "ignorePatterns": ["node_modules", "build", "cdk-deploy", ".react-router"],
  "overrides": [
    {
      "files": ["tests/**/*.ts", "tests/**/*.tsx"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        // Tests deliberately exercise the `children` prop as an API surface.
        "react/no-children-prop": "off",
        // `vi.mocked(obj.method)` is a type-level helper that never invokes the method, so the
        // usual unbound-`this` hazard does not apply.
        "typescript/unbound-method": "off"
      }
    }
  ]
}
