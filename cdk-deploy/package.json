{
  "name": "cdk-deploy",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "bin": {
    "cdk-deploy": "bin/cdk-deploy.js"
  },
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk-deploy": "cdk deploy --require-approval=never",
    "deploy": "npm run build && npm run cdk-deploy",
    "cdk-destroy": "cdk destroy --force",
    "destroy": "npm run build && npm run cdk-destroy"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "aws-cdk": "^2.1100.0",
    "react-app-cdk-deploy": "github:ruchira088/react-app-cdk-deploy#v1"
  }
}
